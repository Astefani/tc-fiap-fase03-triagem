# Copie para .env e preencha. O .env fica fora do Git.

# --- MLflow no DagsHub (D-7). Sem estas variáveis, o treino grava só o metadata.json. ---
# Token: DagsHub → Your Settings → Tokens
MLFLOW_TRACKING_URI=https://dagshub.com/Astefani/tc-fiap-fase03-triagem.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# Experimento onde os runs aparecem (padrão: triagem-laudos). Útil separar testes dos runs oficiais.
# MLFLOW_EXPERIMENT_NAME=triagem-laudos
# Sem MLFLOW_REGISTERED_MODEL: não usamos Model Registry (a produção é o ponteiro do DVC no Git).

# --- Projeto (opcional: os padrões estão em src/triagem/config.py) ---
# TRIAGEM_MODEL_BACKEND=bert-onnx-int8   # tfidf-logreg | bert-onnx | bert-onnx-int8
# TRIAGEM_DIR_MODELOS=models
# TRIAGEM_ONNX_THREADS=4
# TRIAGEM_GATE_F1_MARGEM=0.005
# TRIAGEM_GATE_LATENCIA_GANHO_MIN=0.10
# TRIAGEM_GATE_P95_MAX_MS=5
